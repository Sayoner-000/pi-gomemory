{
  "tools": ["edit", "write", "powershell"],
  "strip": [
    "\\d?>>?\\s*/dev/null",
    "\\d>&\\d"
  ],
  "block": [
    "(^|[;&|(]|&&|\\|\\|)\\s*(sudo\\s+)?(rm|mv|cp|mkdir|touch|chmod|chown|ln|tee|rmdir|truncate|unlink|install|rsync|patch)(\\s|$)",
    "(^|[;&|(]|&&|\\|\\|)\\s*(sudo\\s+)?(bash|sh|zsh)\\s+-c(\\s|$)",
    "(^|[;&|(]|&&|\\|\\|)\\s*(sudo\\s+)?(python|python3|node|perl|ruby)\\s+.*(-[a-zA-Z]*[ce])(\\s|$)",
    "(^|[;&|(]|&&|\\|\\|)\\s*(sudo\\s+)?(xargs|env|make)(\\s|$)",
    "(^|[;&|(]|&&|\\|\\|)\\s*find\\s+.*(-delete|-exec)",
    "(^|[;&|(]|&&|\\|\\|)\\s*dd\\s+.*of=",
    "(^|[;&|(]|&&|\\|\\|)\\s*(curl|wget)\\s+.*(-o|-O)(\\s|$)",
    "\\|\\s*(sudo\\s+)?tee(\\s|$)",
    "(^|[^<>&0-9])>>?\\s*[^\\s&>]",
    "(^|[;&|(]|&&|\\|\\|)\\s*sed\\s+(-[a-zA-Z]*i|--in-place)",
    "(^|[;&|(]|&&|\\|\\|)\\s*git\\s+(commit|push|reset|checkout|switch|merge|rebase|add|rm|mv|restore|stash|cherry-pick|tag|apply|clean|pull)(\\s|$)",
    "(^|[;&|(]|&&|\\|\\|)\\s*(npm|pnpm|yarn|bun)\\s+(install|i|add|remove|uninstall|update|ci)(\\s|$)",
    "(^|[;&|(]|&&|\\|\\|)\\s*go\\s+(mod\\s+tidy|get|install|build\\s+.*-o)(\\s|$)"
  ]
}
